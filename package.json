{
  "name": "vyuha-site-r2",
  "private": true,
  "description": "The public website of vyuha.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs dist",
    "audit:dist": "node scripts/audit-dist.mjs dist",
    "contrast": "node scripts/contrast.mjs --write",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "astro": "7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.6",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
