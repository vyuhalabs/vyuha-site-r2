---
/**
 * The top of an inner page: a small label, the page's one h1 and a lead
 * paragraph. The h1 is the `title` prop; the lead is the default slot.
 */
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<header class="page-header">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead"><slot /></p>
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24)) var(--space-12);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: "";
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-full);
    background: currentColor;
  }

  h1 {
    max-width: 22ch;
    font-size: var(--text-4xl);
  }

  .lead {
    max-width: var(--measure-lead);
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }
</style>
