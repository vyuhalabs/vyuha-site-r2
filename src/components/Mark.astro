---
/**
 * The vyuha mark: five points in one formation, always in the accent colour.
 * Decorative: whatever wraps it carries the accessible name.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg
  class:list={["mark", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="12" cy="5" r="2.5"></circle>
  <circle cx="7.5" cy="11.5" r="2.5"></circle>
  <circle cx="16.5" cy="11.5" r="2.5"></circle>
  <circle cx="3" cy="18" r="2.5"></circle>
  <circle cx="21" cy="18" r="2.5"></circle>
</svg>

<style>
  .mark {
    flex: none;
    color: var(--color-accent);
  }
</style>
