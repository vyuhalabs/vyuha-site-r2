---
import { href, SITE } from "../lib/site";
import Mark from "./Mark.astro";

/** The pages in the header, in order. The home page is the wordmark. */
const pages = [
  { label: "Model", path: "/model/" },
  { label: "Guide", path: "/guide/" },
  { label: "FAQ", path: "/faq/" },
];

const path = Astro.url.pathname.replace(/\/?$/, "/");
const isHome = path === href("/");
---

<header class="site-header">
  <nav class="container site-header__inner" aria-label="Main">
    <a class="wordmark" href={href("/")} aria-current={isHome ? "page" : undefined}>
      <Mark size={22} />
      <span class="wordmark__name">{SITE.name}</span>
      <span class="visually-hidden">, home</span>
    </a>
    <ul class="site-nav" role="list">
      {
        pages.map((p) => (
          <li>
            <a
              class="site-nav__link"
              href={href(p.path)}
              aria-current={path === href(p.path) ? "page" : undefined}
            >
              {p.label}
            </a>
          </li>
        ))
      }
      <li class="site-nav__access">
        <a class="site-nav__link" href={SITE.accessRequest}>Request access</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: var(--header-height);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-heading);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-text);
  }

  .site-nav {
    display: flex;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  /* On a phone the header has room for the pages; the request is in the footer and the pages. */
  .site-nav__access {
    display: none;
  }

  @media (min-width: 40rem) {
    .site-nav {
      gap: var(--space-6);
    }

    .site-nav__access {
      display: list-item;
    }
  }

  .site-nav__link {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current="page"] {
    color: var(--color-text);
  }

  /* The current page is marked by more than colour: an accent underline. */
  .site-nav__link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
</style>
