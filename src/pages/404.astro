---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/site";
---

<BaseLayout
  title="Page not found"
  description="There is no page at this address on the vyuha site."
  noindex
  canonicalPath="/404.html"
>
  <section class="not-found container" aria-labelledby="not-found-title">
    <p class="code">404</p>
    <h1 id="not-found-title">There is no page at this address.</h1>
    <p class="lead">
      The link may be old, or the address may have a typo. The home page links to everything
      on the site.
    </p>
    <p class="back"><a href={href("/")}>Go to the home page</a></p>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--section-space);
  }

  .code {
    margin-bottom: var(--space-4);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  h1 {
    max-width: var(--measure-heading);
  }

  .lead {
    max-width: var(--measure-lead);
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .back {
    margin-top: var(--space-8);
    font-weight: var(--weight-semibold);
  }
</style>
