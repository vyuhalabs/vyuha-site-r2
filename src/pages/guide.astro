---
/**
 * The getting-started guide: access is by request, then the first four
 * steps once a person has it (src/content/docs/guide).
 */
import DocPage from "../components/DocPage.astro";
import NextStep from "../components/NextStep.astro";
import { href, SITE } from "../lib/site";
---

<DocPage
  page="guide"
  title="Getting started"
  heading="Getting started with vyuha."
  eyebrow="Guide"
  description="The first steps with vyuha once you have access: connect a repository, create a project, file a first issue and read a run's evidence. Access is by request."
  image="/og/guide.png"
  imageAlt="vyuha, getting started: connect a repository, create a project, file a first issue, read a run's evidence."
>
  <Fragment slot="lede">
    Access to vyuha is by request. Once you have it, there are four first steps: connect a
    repository, create a project, file a first issue and read a run's evidence.
  </Fragment>
  <NextStep
    title="Questions before you ask?"
    primary={{ label: "Read the FAQ", href: href("/faq/") }}
    secondary={{ label: "Request access on GitHub", href: SITE.accessRequest, external: true }}
  >
    The FAQ answers the questions people ask first, and the model page explains the ideas in plain
    words.
  </NextStep>
</DocPage>
