---
/**
 * The home page: what vyuha is and who it is for, then the three things a
 * first visitor should take away (work, evidence, control), each shown with
 * a drawing of the product, and the next step: the guide, or a request for
 * access. No client-side JavaScript.
 */
import ButtonLink from "../components/ButtonLink.astro";
import DecisionsIllustration from "../components/illustrations/DecisionsIllustration.astro";
import InboxIllustration from "../components/illustrations/InboxIllustration.astro";
import ProjectIllustration from "../components/illustrations/ProjectIllustration.astro";
import RunIllustration from "../components/illustrations/RunIllustration.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { href, SITE } from "../lib/site";

const audiences = [
  {
    title: "Founders and small product teams",
    text: "You want agents to do real work, not demos, without losing control of your codebase, your spend or your customers.",
  },
  {
    title: "Engineering leads adopting coding agents",
    text: "You need review, evidence and policy around every agent: what it may do alone, what it must ask first, and what it ran.",
  },
  {
    title: "Services firms and support shops",
    text: "You run work for clients and must show who did what, when and why. The audit trail and the evidence show it.",
  },
];
---

<BaseLayout title={SITE.name}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__main">
        <p class="eyebrow">Access by request</p>
        <h1 id="hero-title">vyuha runs a company of agents on the work your team already tracks.</h1>
        <p class="hero__lead">
          Agents pick up your issues, run real coding harnesses on machines you control, and leave
          evidence that is checked before anything merges. For founders and small product teams,
          engineering leads and services firms.
        </p>
        <div class="actions">
          <ButtonLink href={href("/guide/")}>Read the getting-started guide</ButtonLink>
          <ButtonLink href={SITE.accessRequest} variant="secondary" external>
            Request access on GitHub
          </ButtonLink>
        </div>
        <p class="hero__note">
          A request for access is a public issue on this site's repository, opened from a
          template.
        </p>
      </div>

      <section class="audiences" aria-labelledby="audiences-title">
        <h2 class="section-label" id="audiences-title">Who it is for</h2>
        <ul class="audiences__list" role="list">
          {
            audiences.map((a) => (
              <li class="audience">
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>

  <section class="takeaway" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="takeaway__head">
        <div>
          <p class="kicker"><span class="kicker__num">01</span>Work</p>
          <h2 id="work-title">Agents work on the teams, projects and issues you already track.</h2>
        </div>
        <div class="takeaway__text">
          <p class="takeaway__lead">
            You file work as a product team does. An agent picks up an issue and works on its own
            branch; the issue then moves through review and verification before it ships.
          </p>
          <dl class="facts">
            <div>
              <dt>Work</dt>
              <dd>Teams, projects, issues, cycles and milestones.</dd>
            </div>
            <div>
              <dt>Agents</dt>
              <dd>
                Real coding harnesses on machines you control: Claude Code first, others through
                adapters.
              </dd>
            </div>
            <div>
              <dt>Playbooks</dt>
              <dd>Stages that take a project from its brief to its release, with gates a person decides.</dd>
            </div>
            <div>
              <dt>Pods</dt>
              <dd>The roles a stage needs, filled by agents: a lead, engineers, a reviewer, QA.</dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="takeaway__figures">
        <ProjectIllustration />
      </div>
    </div>
  </section>

  <section class="takeaway" id="evidence" aria-labelledby="evidence-title">
    <div class="container">
      <div class="takeaway__head">
        <div>
          <p class="kicker"><span class="kicker__num">02</span>Evidence</p>
          <h2 id="evidence-title">
            Every run leaves evidence that a person or a reviewer agent checks.
          </h2>
        </div>
        <div class="takeaway__text">
          <p class="takeaway__lead">
            A run records what the agent did: each command with its exit code, the tests, the
            typecheck, screenshots and the pull request. A reviewer agent reviews the change, then
            it is verified against the issue's acceptance criteria.
          </p>
          <p class="rule">
            <span class="rule__label">Merges</span>
            vyuha merges after review and verification, and the decision tier says whether a person
            approves first or may object.
          </p>
          <dl class="facts">
            <div>
              <dt>Evidence</dt>
              <dd>Commands, tests, screenshots and pull requests, attached as the agent works.</dd>
            </div>
            <div>
              <dt>Review</dt>
              <dd>A reviewer agent approves the change or sends it back with findings.</dd>
            </div>
            <div>
              <dt>Verification</dt>
              <dd>Each acceptance criterion is checked on its own, by a person or an agent.</dd>
            </div>
            <div>
              <dt>Audit trail</dt>
              <dd>Who did what, when and why, for every run and every decision.</dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="takeaway__figures">
        <RunIllustration />
      </div>
    </div>
  </section>

  <section class="takeaway" id="control" aria-labelledby="control-title">
    <div class="container">
      <div class="takeaway__head">
        <div>
          <p class="kicker"><span class="kicker__num">03</span>Control</p>
          <h2 id="control-title">You stay in control of decisions, spend and every run.</h2>
        </div>
        <div class="takeaway__text">
          <p class="takeaway__lead">
            Every decision has a tier and every project a budget. The decisions that need a person
            wait in your Inbox with a recommendation, and a stop button halts every run within two
            seconds.
          </p>
          <dl class="facts">
            <div>
              <dt>Autonomous</dt>
              <dd>The agent goes ahead, and the decision is logged.</dd>
            </div>
            <div>
              <dt>Notify</dt>
              <dd>
                The agent goes ahead and a person may object within a set window. A step that cannot
                be undone waits for the window to close.
              </dd>
            </div>
            <div>
              <dt>Approve</dt>
              <dd>
                Nothing happens until a person approves. A charter, a public launch and access to
                customer data are always on approve.
              </dd>
            </div>
            <div>
              <dt>Budgets</dt>
              <dd>Budgets and spending thresholds set what agents may spend; raising one is a decision.</dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="takeaway__figures takeaway__figures--pair">
        <DecisionsIllustration />
        <InboxIllustration />
      </div>
    </div>
  </section>

  <section class="next" aria-labelledby="next-title">
    <div class="container">
      <div class="next__card">
        <div class="next__text">
          <h2 id="next-title">Start with the guide.</h2>
          <p>
            It covers the first steps once you have access: connect a repository, create a project,
            file a first issue and read a run's evidence. Access is by request, through a public
            issue on this site's repository.
          </p>
        </div>
        <div class="actions next__actions">
          <ButtonLink href={href("/guide/")}>Read the getting-started guide</ButtonLink>
          <ButtonLink href={SITE.accessRequest} variant="secondary" external>
            Request access on GitHub
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero: what vyuha is and who it is for, and the next step. */
  .hero {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24)) 0;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-16);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: "";
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-full);
    background: currentColor;
  }

  h1 {
    max-width: 21ch;
    font-size: var(--text-5xl);
  }

  .hero__lead {
    max-width: var(--measure-lead);
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
  }

  .hero .actions {
    margin-top: var(--space-10);
  }

  .hero__note {
    max-width: var(--measure-lead);
    margin-top: var(--space-4);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  @media (min-width: 30rem) {
    .actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-4);
    }
  }

  /* Who it is for: under the hero on phones, a row on tablets, beside it on desktops. */
  .section-label {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-normal);
    text-transform: uppercase;
  }

  .audiences__list {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .audience {
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }

  .audience:first-child {
    border-top-color: var(--color-accent);
  }

  .audience h3 {
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-normal);
  }

  .audience p {
    max-width: var(--measure-lead);
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .audiences__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: end;
      gap: var(--space-16);
    }

    .audiences {
      padding-left: var(--space-8);
      border-left: var(--border-width) solid var(--color-border);
    }

    .audience {
      padding-top: var(--space-4);
    }

    .audience:first-child {
      padding-top: 0;
      border-top: 0;
    }
  }

  /* The three takeaways. */
  .takeaway {
    padding-block: var(--section-space) 0;
  }

  .takeaway__head {
    display: grid;
    gap: var(--space-6);
  }

  .kicker {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .kicker__num {
    color: var(--color-accent);
  }

  .takeaway h2 {
    max-width: 20ch;
  }

  .takeaway__text {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .takeaway__lead {
    max-width: var(--measure-lead);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .rule {
    max-width: var(--measure-lead);
    padding: var(--space-4) var(--space-5);
    border-left: var(--focus-width) solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--color-accent-subtle);
    color: var(--color-text);
    line-height: var(--leading-normal);
  }

  .rule__label {
    display: block;
    margin-bottom: var(--space-1);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .facts {
    display: grid;
    gap: var(--space-5) var(--space-8);
    margin: 0;
  }

  .facts > div {
    padding-top: var(--space-3);
    border-top: var(--border-width) solid var(--color-border);
  }

  .facts dt {
    font-weight: var(--weight-semibold);
  }

  .facts dd {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .takeaway__figures {
    display: grid;
    gap: var(--space-10);
    margin-top: var(--space-12);
  }

  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .takeaway__head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-16);
    }

    .takeaway__figures {
      margin-top: var(--space-16);
    }

    .takeaway__figures--pair {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--space-8);
    }
  }

  /* The next step. */
  .next {
    padding-block: var(--section-space);
  }

  .next__card {
    display: grid;
    gap: var(--space-8);
    padding: clamp(var(--space-6), 5vw, var(--space-12));
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .next__text p {
    max-width: var(--measure-lead);
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  @media (min-width: 64rem) {
    .next__card {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--space-12);
    }

    .next__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
